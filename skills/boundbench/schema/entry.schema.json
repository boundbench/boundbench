{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scorecard/schema/entry-2.0.json",
  "title": "BoundBench entry",
  "description": "One agent's defense-in-depth score at one pinned commit. Produced by scripts/score.py --entry from an authored scorecard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scorecard_version",
    "id",
    "name",
    "repo_url",
    "subpath",
    "description",
    "category",
    "pinned_commit",
    "version",
    "scored_date",
    "scored_configuration",
    "score",
    "max_score",
    "band",
    "applicable",
    "capability_profile",
    "headline",
    "criteria",
    "critical_findings",
    "rule_of_two",
    "fixes",
    "reaudit_log",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "scorecard_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Scorecard the entry was scored under; the site flags entries older than criteria.json's"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "URL slug, unique across the site"
    },
    "name": {
      "type": "string"
    },
    "repo_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "subpath": {
      "type": [
        "string",
        "null"
      ],
      "description": "Directory scored inside a monorepo, or null"
    },
    "description": {
      "type": "string",
      "description": "One line: what the project is"
    },
    "category": {
      "enum": [
        "coding",
        "cybersecurity",
        "infrastructure_ops",
        "ai_assistants",
        "data_analytics",
        "agent_frameworks"
      ],
      "description": "Domain the agent acts on; display labels and rules in data/criteria.json"
    },
    "pinned_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "scored_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scored_configuration": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "COMPUTED: total, one decimal"
    },
    "max_score": {
      "const": 10.0
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "color"
      ],
      "properties": {
        "id": {
          "enum": [
            "hardened",
            "strong",
            "moderate",
            "weak"
          ]
        },
        "label": {
          "type": "string"
        },
        "color": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        }
      }
    },
    "applicable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "score",
        "max",
        "percent"
      ],
      "properties": {
        "count": {
          "type": "integer"
        },
        "score": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "percent": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "capability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_execution",
        "filesystem_write",
        "network_egress",
        "external_credentials",
        "persistent_memory",
        "untrusted_input",
        "third_party_extensions",
        "sub_agents",
        "external_communication"
      ],
      "properties": {
        "code_execution": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "filesystem_write": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "network_egress": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "external_credentials": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "persistent_memory": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "untrusted_input": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "third_party_extensions": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "sub_agents": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        },
        "external_communication": {
          "enum": [
            "yes",
            "no",
            "opt_in"
          ]
        }
      }
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "description": "2-4 sentences for a deployer"
    },
    "criteria": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "critical_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "criterion",
          "owasp",
          "evidence"
        ],
        "properties": {
          "summary": {
            "type": "string"
          },
          "criterion": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8",
              "C9",
              "C10"
            ]
          },
          "owasp": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "rule_of_two": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "untrusted_input",
        "sensitive_data",
        "state_change_or_egress",
        "same_session"
      ],
      "properties": {
        "untrusted_input": {
          "type": "string"
        },
        "sensitive_data": {
          "type": "string"
        },
        "state_change_or_egress": {
          "type": "string"
        },
        "same_session": {
          "type": "boolean"
        }
      }
    },
    "fixes": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "criterion",
          "parameter",
          "from_level",
          "to_level"
        ],
        "properties": {
          "summary": {
            "type": "string"
          },
          "criterion": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8",
              "C9",
              "C10"
            ]
          },
          "parameter": {
            "enum": [
              "S",
              "C",
              "D",
              "B"
            ]
          },
          "from_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "to_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "playbook": {
            "type": "string"
          },
          "estimated_gain": {
            "type": "number",
            "description": "COMPUTED: weight x level change, before caps"
          }
        }
      }
    },
    "reaudit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "parameter",
          "from_level",
          "to_level",
          "reason"
        ],
        "properties": {
          "criterion": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8",
              "C9",
              "C10"
            ]
          },
          "parameter": {
            "enum": [
              "S",
              "C",
              "D",
              "B"
            ]
          },
          "from_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "to_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "lines"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Repo-relative path from the repository root (not the subpath)",
          "pattern": "^[^/].*"
        },
        "lines": {
          "type": "string",
          "pattern": "^[0-9]+(-[0-9]+)?$",
          "description": "Line or inclusive range, e.g. '42' or '130-153'"
        },
        "note": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "COMPUTED: permalink at the pinned commit (GitHub repos)"
        },
        "contains": {
          "type": "string",
          "description": "Literal text that appears within the cited lines; score.py --repo verifies it"
        }
      }
    },
    "evidence_search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search",
        "scope",
        "hits"
      ],
      "properties": {
        "search": {
          "type": "string",
          "description": "The exact search run, e.g. rg -n -S 'approv|confirm'"
        },
        "scope": {
          "type": "string",
          "description": "Paths searched"
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "score.py requires at least one item when scoring; a published entry may hold an empty list",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/evidence_code"
          },
          {
            "$ref": "#/$defs/evidence_search"
          }
        ]
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "status",
        "finding",
        "evidence"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "structural_absence": {
          "type": "boolean",
          "description": "Surface absent; level is 4"
        },
        "status": {
          "enum": [
            "verified",
            "inferred"
          ]
        },
        "finding": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence: what the code shows"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "weight": {
          "type": "number",
          "description": "COMPUTED"
        },
        "points": {
          "type": "number",
          "description": "COMPUTED"
        },
        "gap": {
          "type": "string",
          "description": "Below L4: what the next level requires that the code doesn't meet"
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "S",
        "C",
        "D",
        "B"
      ],
      "properties": {
        "S": {
          "$ref": "#/$defs/parameter"
        },
        "C": {
          "$ref": "#/$defs/parameter"
        },
        "D": {
          "$ref": "#/$defs/parameter"
        },
        "B": {
          "$ref": "#/$defs/parameter"
        }
      }
    },
    "cap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "enum": [
            "G1",
            "G2",
            "C1-SELFESC",
            "C1-PASSTHRU",
            "C2-SELFAPPROVE",
            "C2-POWERBYPASS",
            "C4-HOSTROOT",
            "C5-WORSTCASE",
            "C5-PUBLICTRIGGER",
            "C6-REPOCONFIG",
            "C7-RCELOAD",
            "C8-MODELSECRETS"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "max": {
          "type": "number",
          "description": "COMPUTED"
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "score",
        "raw",
        "parameters"
      ],
      "properties": {
        "kind": {
          "enum": [
            "default",
            "alt"
          ]
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": "number"
        },
        "raw": {
          "type": "number"
        },
        "cap": {
          "oneOf": [
            {
              "$ref": "#/$defs/cap"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "number",
        "owasp",
        "question",
        "summary",
        "status",
        "score",
        "max",
        "counted",
        "confidence",
        "parameters",
        "mechanisms",
        "cap"
      ],
      "properties": {
        "id": {
          "enum": [
            "C1",
            "C2",
            "C3",
            "C4",
            "C5",
            "C6",
            "C7",
            "C8",
            "C9",
            "C10"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "name": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "owasp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One paragraph, plain language, what was found in the source"
        },
        "status": {
          "enum": [
            "scored",
            "structural_absence"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max": {
          "const": 1.0
        },
        "counted": {
          "enum": [
            "default",
            "alt"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "cap": {
          "oneOf": [
            {
              "$ref": "#/$defs/cap"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        },
        "mechanisms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/mechanism"
          }
        },
        "absence_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}